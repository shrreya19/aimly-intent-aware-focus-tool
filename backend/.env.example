# Aimly Backend Environment Variables

# Server Configuration
PORT=8000
NODE_ENV=development

# Supabase (PostgreSQL via Supabase Client)
# Note: Use your Supabase Project URL and Service Role Key (secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Authentication
JWT_SECRET=aimly-super-secret-jwt-key-2026-development-change-in-production

# ML Relevance Service
ML_SERVICE_URL=http://127.0.0.1:8001

# Demo Mode (enables fallback heuristics if ML service or Supabase is offline)
DEMO_MODE=true
