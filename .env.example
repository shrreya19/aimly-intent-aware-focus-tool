# Aimly Root Environment Template
# Duplicate this file to .env and fill in your real credentials

PORT=8000
NODE_ENV=development

# Supabase PostgreSQL
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Authentication
JWT_SECRET=your-production-jwt-secret-key-min-32-chars

# ML Relevance Microservice
ML_SERVICE_URL=http://127.0.0.1:8001

# Demo Mode (enables fallback heuristics if ML service or Supabase is offline)
DEMO_MODE=true
